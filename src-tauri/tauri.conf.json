{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dBound",
  "version": "0.2.0",
  "identifier": "com.dbound.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dBound",
        "width": 420,
        "height": 640,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --use-fake-ui-for-media-stream"
      },
      {
        "label": "mini",
        "title": "dBound Mini",
        "url": "mini.html",
        "width": 158,
        "height": 58,
        "x": -30000,
        "y": -30000,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --use-fake-ui-for-media-stream",
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "full",
        "title": "dBound Fullscreen",
        "url": "full.html",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --use-fake-ui-for-media-stream",
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
          "installerHooks": "nsis/hooks.nsh",
      "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "dBound"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "../resources/使用说明.txt": "文档/使用说明.txt",
      "../resources/版本信息.txt": "文档/版本信息.txt",
      "../resources/LICENSE.txt": "文档/LICENSE.txt",
      "../src/assets/fluent-emoji/*.png": "resources/emoji/",
      "../src/assets/emoji/*.png": "resources/emoji-reward/"
    },
    "publisher": "Source X",
    "copyright": "Copyright © 2026 Source X. All rights reserved.",
    "shortDescription": "dBound · 桌面音量哨兵",
    "longDescription": "dBound 是面向课堂与自习场景的桌面响度提示工具：实时估测麦克风响度、按级别提醒、全屏投屏、证据录制。"
  }
}
